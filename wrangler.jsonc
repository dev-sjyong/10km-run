{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "run10k-weather-scheduler",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-09-01",
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://dev-sjyong.github.io",
    "VAPID_SUBJECT": "https://dev-sjyong.github.io/10km-run/"
  },
  "kv_namespaces": [
    {
      "binding": "WEATHER_STATE",
      "id": "5a42cdea0c654e55b9fe398b0aedd6b7"
    }
  ]
}
